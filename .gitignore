# ── 素材处理链中间产物（跑 scripts/*.py 可再生，不入仓库） ──
step01/
step02/
step03/
step04/

# ── 素材源（托管在 GitHub Releases assets-videos，不入仓库） ──
video/*.mp4

# ── PR 手工抠像工作数据（本地工作数据，同 step 中间产物，不入库） ──
#   pr/      PR 导出的透明 .mov（路线 B 的输入）
#   prproj/  PR 工程目录（.prproj + 遮罩缓存 + 自动保存，约 2GB）
pr/
prproj/

# ── 本地工具（机器相关，不入仓库） ──
.tools/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# ── Node ──
node_modules/
.npm-cache/
npm-debug.log*
*.tgz

# ── 临时/备份目录 ──
temp/

# ── dsh-pet lib ──
# 注意：本仓库的 dsh-pet/lib/*.js 是手写的运行时源码（非 tsdown 构建产物），
# 必须入库并被 npm 发布（package.json 的 files 含 lib）。请勿忽略。
# src/ 是等价的 TypeScript 版，供想改源码者参考；两者并存、均跟踪。

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini
